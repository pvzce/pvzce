  "dialogue": {
    "lines": [
      {
        "character": "pvzce:purwhite",
        "portrait": "smile",
        "text": "又来了一位新成员嘛？",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "startled",
        "text": "等等！这位是？",
        "voice": "",
        "side": "left",
        "animation": {
          "type": "shake"
        }
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "startled",
        "text": "毁—灭—菇—大—人",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "star",
        "text": "他...他是最...最厉害的蘑菇！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "star",
        "text": "超...超级厉害！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "star",
        "text": "轰的一下子，一大片僵尸都消失了",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "wink",
        "text": "有他的帮助，打僵尸会很容易呢",
        "voice": "",
        "side": "left"
      }
    ]
  },
