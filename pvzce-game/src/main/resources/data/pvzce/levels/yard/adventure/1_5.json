  "dialogue": {
    "lines": [
      {
        "character": "pvzce:pea_chan",
        "portrait": "smile",
        "text": "哇！你好厉害喵！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "smile",
        "text": "已经战胜了这么多僵尸了呢",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "blush",
        "text": "看得咱都有点...",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "panic",
        "text": "诶诶诶！才不是你想的那样！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "smile",
        "text": "嗯哼，回到正题",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "smile",
        "text": "你要不要试试打保龄球喵？",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "smile",
        "text": "就是...用坚果，然后，通通通！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "smile",
        "text": "就这样，僵尸们就被解决啦！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "confused",
        "text": "诶不过，为什么要用坚果呢？",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "confused",
        "text": "我也不知道嘿嘿，你去问戴夫喵",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "zako",
        "text": "去战斗吧，杂鱼~",
        "voice": "",
        "side": "left"
      }
    ]
  },
