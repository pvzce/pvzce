    "lines": [
      {
        "character": "pvzce:pea_chan",
        "portrait": "smile",
        "text": "呼~ 不知不觉",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "smile",
        "text": "已经陪你这么久了呢",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "blush",
        "text": "的确有点....",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "panic",
        "text": "才不是才不是！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "tsundere",
        "text": "咱不会！不要想歪了！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "confused",
        "text": "不过，是不是天快黑了呢？",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "confused",
        "text": "晚上还要打僵尸吗？",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "disappointed",
        "text": "那还挺失望的呢...",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:pea_chan",
        "portrait": "zako",
        "text": "唔... 总之咱们白天还是可以再见的",
        "voice": "",
        "side": "left"
      }
    ]
