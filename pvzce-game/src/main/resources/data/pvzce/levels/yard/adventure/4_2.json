          }
        ]
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "star",
        "text": "哇！好厉害！",
        "voice": "",
        "side": "left",
        "slots": [
          {
            "slot": "left",
            "character": "pvzce:purwhite"
          },
          {
            "slot": "right",
            "character": "pvzce:lantina"
          }
        ]
      },
      {
        "character": "pvzce:lantina",
        "portrait": "confident",
        "text": "那就让我来为大家送去光明吧！",
        "voice": "",
        "side": "right",
