  "dialogue": {
    "lines": [
      {
        "character": "pvzce:purwhite",
        "portrait": "confused",
        "text": "原来可以走右边吗？",
        "voice": "",
        "side": "right"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "confused",
        "text": "一直以为只能在左边的来着。",
        "voice": "",
        "side": "right"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "playful",
        "text": "诶嘿，咱还是回到左边吧",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "confident",
        "text": "对啦，咱们蘑菇家族又来了一个新伙伴呢",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "confident",
        "text": "大—喷—菇！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "star",
        "text": "她超超超超超级厉害呢！",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "star",
        "text": "咱其实很羡慕她的",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "confused",
        "text": "会有一天...",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "confused",
        "text": "我也可以变得那么强的，对吗？",
        "voice": "",
        "side": "left"
      }
    ]
  },
