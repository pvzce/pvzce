      {
        "character": "pvzce:purwhite",
        "portrait": "gentle",
        "text": "",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "gentle",
        "text": "但是还是要去打僵尸呢",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "confident",
        "text": "咱们都已经打败了好多好多僵尸了呢",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "confident",
        "text": "对你来说，肯定已经不在话下了对不对~",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "flighty",
        "text": "你真厉害！",
        "voice": "",
        "side": "center"
      }
