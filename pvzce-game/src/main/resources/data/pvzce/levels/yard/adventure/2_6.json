      },
      {
        "character": "pvzce:purwhite",
        "portrait": "startled",
        "text": "好...好像有厉害的僵尸过来了...",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "gentle",
        "text": "能不能...",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
        "portrait": "gentle",
        "text": "帮忙打败它...",
        "voice": "",
        "side": "left"
      },
      {
        "character": "pvzce:purwhite",
